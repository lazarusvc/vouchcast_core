@model IEnumerable<VC_IMS.Models.VC_reports>
@{
    ViewData["Title"] = "Reports (Admin)";
}

@if (TempData["Ok"] is string ok && !string.IsNullOrWhiteSpace(ok))
{
    <div class="alert alert-success">@ok</div>
}


<p><a class="btn btn-success" asp-action="Create">New Report</a></p>
<table class="table table-sm align-middle">
    <thead><tr><th>Name</th><th>Description</th><th>Role</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Name</td>
                        <td>@r.Desc</td>
                        <td>@r.RoleId</td>
                        <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="ReportParams" asp-action="Index" asp-route-reportId="@r.Id">Add Params</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                            <form asp-action="Duplicate" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-info" type="submit">Duplicate</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
</table>


<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/js/datatables.min.js"></script>
<script type="text/javascript"> let table = new DataTable('#dataTable');</script>