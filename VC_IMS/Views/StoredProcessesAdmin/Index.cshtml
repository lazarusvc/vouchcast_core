@using VC_IMS.Helpers
@model IEnumerable<VC_IMS.Models.VC_storedProcess>
@{
    ViewData["Title"] = "Stored Processes (Admin)";
}


<div class="row">
    <div class="col-sm-12">
        <div class="card basic-data-table" style="overflow-x: scroll; height:500px;">
            <div class="card-header">
                <a class="btn btn-success" asp-action="Create">Create Process</a>
            </div>
            <div class="card-body">
                <table class="table bordered-table mb-0" id="dataTable" data-page-length='10'>
                    <thead>
                        <tr>
                            <th>Manage</th>
                            <th>Category</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Connection</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    <a asp-area="" asp-controller="StoredProcessParams" asp-action="Index" asp-route-processId="@p.Id" class="w-32-px h-32-px bg-primary-light text-primary-600 rounded-circle d-inline-flex align-items-center justify-content-center"><iconify-icon icon="gravity-ui:bars-play"></iconify-icon></a>
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="w-32-px h-32-px bg-success-focus text-success-main rounded-circle d-inline-flex align-items-center justify-content-center"><iconify-icon icon="lucide:edit"></iconify-icon></a>
                                    <a asp-action="Delete" asp-route-id="@p.Id" class="w-32-px h-32-px bg-danger-focus text-danger-main rounded-circle d-inline-flex align-items-center justify-content-center"><iconify-icon icon="gravity-ui:trash-bin"></iconify-icon></a>
                                    <a asp-area="" asp-controller="StoredProcesses" asp-action="Run" asp-route-id="@p.Id" class="w-32-px h-32-px bg-purple-light text-purple-main rounded-circle d-inline-flex align-items-center justify-content-center"><iconify-icon icon="ri:play-mini-line"></iconify-icon></a>
                                </td>
                                <td>
                                    <span class="category-badge @CategoryHelper.GetCategoryBadgeClass(p.Category)">
                                        @p.Category
                                    </span>
                                </td>
                                <td>@p.Name</td>
                                <td>@p.Description</td>
                                <td>@(string.IsNullOrWhiteSpace(p.ConnectionKey) ? $"{p.DataSource}/{p.Database}" : p.ConnectionKey)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<link href="~/css/site.css" rel="stylesheet" />
<script type="text/javascript">
    // ------------------------------------------- TABLE DATATABLE INIT
    let table = new DataTable('#dataTable');
</script>