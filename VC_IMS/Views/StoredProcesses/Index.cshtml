@model IEnumerable<VC_IMS.Models.VC_storedProcess>
@{
    ViewData["Title"] = "Stored Procedures";
}

<div class="row">
    <div class="col-sm-12">
        <div class="card basic-data-table" style="overflow-x: scroll; height:500px;">
            <div class="card-header">
                <p>@ViewBag.hfstatus Define a process once, run it with current parameters. Connections can use a named key or per-process server/DB.</p>
            </div>
            <div class="card-body">
                <table class="table bordered-table mb-0" id="dataTable" data-page-length='10'>
                    <thead>
                        <tr>
                            <th>Manage</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Connection</th>                            
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-area="" asp-controller="StoredProcesses" asp-action="Run" asp-route-id="@p.Id" class="w-32-px h-32-px bg-purple-light text-purple-main rounded-circle d-inline-flex align-items-center justify-content-center"><iconify-icon icon="ri:play-mini-line"></iconify-icon></a>
                                </td>
                                <td>@p.Name</td>
                                <td>@p.Description</td>
                                <td>@(string.IsNullOrWhiteSpace(p.ConnectionKey) ? $"{p.DataSource}/{p.Database}" : p.ConnectionKey)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script type="text/javascript">
    // ------------------------------------------- TABLE DATATABLE INIT
    let table = new DataTable('#dataTable');
</script>